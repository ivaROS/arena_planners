[campc]
horiz = 4
        # MPC horizon (steps) = 1.0s/~1.0m at _TIME_STEP=0.25. This is the REAL-TIME
        # CEILING, not a free choice: horiz=8 was TESTED (2026-06-23) and nearly doubled
        # the solve (median 0.30->0.48s, p90 0.59) -- the "extra dynamics steps are
        # cheap" assumption is FALSE for this bilevel NLP -- which blew campc's 0.30s
        # ipopt.max_cpu_time cap ~35% of the time (status=-5 Maximum_CpuTime_Exceeded).
        # A failed solve returns a degenerate warmstart (v=+-0.3, omega=+-0.52 flipping,
        # even reverse), so horiz=8 made the wiggle WORSE and the robot crawl. Keep 4.
        # The short-horizon turn-in-place tendency is mitigated instead by the align
        # shim (planner.py _ALIGN_ENTER) handling large initial turns crisply, and by
        # the MPC's gentle (<=0.52 rad/s) weave being acceptable once pivots are gone.
soft_constraints = true
        # soften constraints by adding penalized slack
term_const = false
        # whether to have a terminal MPC constraint
ref_type = path_foll
        # reference signal for MPC controller: path_foll, traj_track, point_stab.
        # path_foll (not point_stab): point_stab references the final goal with
        # ref_v=0, which for a nonholonomic unicycle oscillates/stalls on approach.
        # path_foll tracks a moving point along the reference at pref_speed and
        # drives reliably. planner.py regenerates the reference on each goal change.
new_ref_each_step = false
        # re-calculate a new reference each step
warmstart = true
        # whether or not to use a warmstart strategy for solving mpc


[mpc_env]
hum_model = orca_casadi_kkt
        # human model: 'orca_casadi_kkt' (SICNav-p / SICNav-np) or 'cvmm' (MPC-CVMM)
priviledged_info = false
        # SICNav-np: robot does NOT have human goals; they are estimated internally.
        # Arena's pedestrian obs give position+velocity only, which is exactly this
        # mode's input. Set true for SICNav-p only if a true human-goal source is wired.
orca_kkt_horiz = 4
        # subset of horizon where ORCA constraints model the humans
human_v_max_assumption = 1.2
        # robot's assumption of human max speed (used when priviledged_info=false).
        # Matches the pedestrian max_vel (1.2) so the internal ORCA prediction does
        # not under-model how fast humans move. Was 0.5 (tuned for the old 0.3 peds).
rob_rad_buffer = 0.10
        # buffer added to robot radius for the MPC collision constraint. Was 0.02
        # (near-zero margin); soft constraints then let the robot overlap a human
        # (min center-to-center 0.43m vs 0.6m sum-of-radii). 0.10 gives a 10cm
        # safety margin so the penalised soft constraint bites before contact.
        # NOTE: tested 0.50 (5x) on the forced-crossing scenario -> NO improvement
        # (min 0.21m vs 0.19m): the collision is a human-PREDICTION mismatch, not a
        # constraint-margin issue, so collision safety is handled by the reactive
        # _safety_brake() in planner.py (prediction-independent), not this buffer.
pref_speed = 0.30
        # robot preferred speed (keep in sync with planner.py _V_PREF). 0.30 = INTERIM
        # SAFETY cap: a forced pedestrian-crossing test showed SICNav driving THROUGH
        # the crosser at 0.55 m/s (converged solves, min 0.19m center-to-center vs 0.6
        # sum-radii) -- soft collision constraints + the ORCA reciprocal-avoidance
        # assumption (Arena peds use social forces) let the MPC plan through. Until
        # avoidance is hardened, cruise slow for more reaction time. Raise once the
        # collision-constraint / human-prediction issue is fixed.
max_speed = 0.35
        # robot maximum speed (keep in sync with planner.py _V_MAX)
max_rev_speed = 0.35
        # robot maximum reverse speed
max_rot_degrees = 30
        # robot max rotation PER TIME-STEP, degrees (keep in sync with _OMEGA_MAX).
        # Was 60 at _TIME_STEP=0.5 (=120 deg/s). At _TIME_STEP=0.25 (4Hz) 30 deg/step
        # keeps the same physical ~120 deg/s; leaving it 60 would give 240 deg/s.
max_l_acc = 0.5
        # robot maximum linear acceleration (m/s)
max_l_dcc = -1.5
        # robot maximum linear deceleration, must be negative (m/s)
orca_ksi_scaling = 1e-2
orca_vxy_scaling = 1e0
orca_lambda_scaling = 1.0
        # scaling variables in the orca kkt constraints for solver performance


[orca_plus]
visible = true
radius = 0.3
safety_space = 0.01
v_pref = 1.5
sensor = coordinates


[dwa]
acc_max = 0.5
ang_acc_max = 1.04
ang_acc_res_deg = 0.5
max_d = 2.0
