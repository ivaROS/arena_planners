[campc]
horiz = 4
        # MPC horizon
soft_constraints = true
        # soften constraints by adding penalized slack
term_const = false
        # whether to have a terminal MPC constraint
ref_type = path_foll
        # reference signal for MPC controller: path_foll, traj_track, point_stab.
        # path_foll (not point_stab): point_stab references the final goal with
        # ref_v=0, which for a nonholonomic unicycle oscillates/stalls on approach.
        # path_foll tracks a moving point along the reference at pref_speed and
        # drives reliably. planner.py regenerates the reference on each goal change.
new_ref_each_step = false
        # re-calculate a new reference each step
warmstart = true
        # whether or not to use a warmstart strategy for solving mpc


[mpc_env]
hum_model = orca_casadi_kkt
        # human model: 'orca_casadi_kkt' (SICNav-p / SICNav-np) or 'cvmm' (MPC-CVMM)
priviledged_info = false
        # SICNav-np: robot does NOT have human goals; they are estimated internally.
        # Arena's pedestrian obs give position+velocity only, which is exactly this
        # mode's input. Set true for SICNav-p only if a true human-goal source is wired.
orca_kkt_horiz = 4
        # subset of horizon where ORCA constraints model the humans
human_v_max_assumption = 0.5
        # robot's assumption of human max speed (used when priviledged_info=false)
rob_rad_buffer = 0.02
        # buffer added to robot radius for the MPC collision constraint
pref_speed = 0.90
        # robot preferred speed (keep in sync with planner.py _V_PREF)
max_speed = 0.95
        # robot maximum speed (keep in sync with planner.py _V_MAX)
max_rev_speed = 0.95
        # robot maximum reverse speed
max_rot_degrees = 60
        # robot max rotation per time-step, degrees (keep in sync with _OMEGA_MAX)
max_l_acc = 0.5
        # robot maximum linear acceleration (m/s)
max_l_dcc = -1.5
        # robot maximum linear deceleration, must be negative (m/s)
orca_ksi_scaling = 1e-2
orca_vxy_scaling = 1e0
orca_lambda_scaling = 1.0
        # scaling variables in the orca kkt constraints for solver performance


[orca_plus]
visible = true
radius = 0.3
safety_space = 0.01
v_pref = 1.5
sensor = coordinates


[dwa]
acc_max = 0.5
ang_acc_max = 1.04
ang_acc_res_deg = 0.5
max_d = 2.0
